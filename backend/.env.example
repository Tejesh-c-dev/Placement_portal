# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/placement_portal
MONGODB_URI_TEST=mongodb://localhost:27017/placement_portal_test

# Superadmin Bootstrap (used by `npm run seed`)
SUPERADMIN_EMAIL=admin@placement.edu
SUPERADMIN_PASSWORD=Admin@123

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secure-access-token-secret-key-here
JWT_REFRESH_SECRET=your-super-secure-refresh-token-secret-key-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Reset Token
RESET_PASSWORD_EXPIRY=3600000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@placementportal.com

# Redis Configuration (for Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Pagination Defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000
